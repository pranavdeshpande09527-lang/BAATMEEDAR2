{
    "name": "baatmeedar2.0",
    "version": "1.0.0",
    "description": "BAATMEEDAR — The Gatekeeper of Truth. AI newsroom for inspectable factual claim verification.",
    "main": "src/server.js",
    "scripts": {
        "postinstall":  "prisma generate",
        "db:reset":     "node node_modules/prisma/build/index.js migrate reset --force",
        "db:studio":    "node node_modules/prisma/build/index.js studio",
        "db:migrate":   "node node_modules/prisma/build/index.js migrate dev",
        "db:deploy":    "node node_modules/prisma/build/index.js migrate deploy",
        "db:generate":  "node node_modules/prisma/build/index.js generate",
        "db:push":      "node node_modules/prisma/build/index.js db push",
        "start":        "node src/server.js",
        "start:prod":   "NODE_ENV=production node src/server.js",
        "render-start": "npx prisma migrate deploy && node src/server.js",
        "dev":          "node --watch src/server.js",
        "pm2:start":    "pm2 start ecosystem.config.js --env production",
        "pm2:dev":      "pm2 start ecosystem.config.js --env development",
        "pm2:stop":     "pm2 stop baatmeedar",
        "pm2:reload":   "pm2 reload baatmeedar",
        "pm2:logs":     "pm2 logs baatmeedar",
        "test":         "echo 'Run test files in /test directly with node'"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@prisma/client":     "^5.22.0",
        "axios":              "^1.20.0",
        "cheerio":            "^1.2.0",
        "cors":               "^2.8.6",
        "dotenv":             "^17.4.2",
        "express":            "^5.2.1",
        "express-rate-limit": "^7.5.0",
        "express-validator":  "^7.3.2",
        "helmet":             "^8.3.0",
        "node-cache":         "^5.1.2",
        "pino":               "^9.7.0",
        "pino-http":          "^10.4.0",
        "prisma":             "^5.22.0",
        "youtube-transcript": "^1.3.1"
    },
    "devDependencies": {
        "pino-pretty": "^13.0.0",
        "pm2":         "^5.4.3"
    }
}
