# ─── Database ─────────────────────────────────────────────────────────────────
# REQUIRED. SQLite path for single-server deployments.
# For PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="file:./dev.db"

# ─── API Keys ─────────────────────────────────────────────────────────────────
# REQUIRED — obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# REQUIRED — obtain from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# REQUIRED — obtain from https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# REQUIRED — obtain from https://console.developers.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# OPTIONAL. Comma-separated list of allowed frontend origins.
# Use '*' only during local development (insecure in production).
# Example: https://baatmeedar.yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=*

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# OPTIONAL. Window in milliseconds and max requests per IP per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# ─── Pipeline ─────────────────────────────────────────────────────────────────
# OPTIONAL. Maximum time in ms a single pipeline run can take before being killed.
PIPELINE_TIMEOUT_MS=300000

# ─── Logging ──────────────────────────────────────────────────────────────────
# OPTIONAL. One of: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── API Budget Controls ──────────────────────────────────────────────────────
# OPTIONAL — tune API spend per check.
MAX_CLAIMS_PER_CHECK=8
MAX_SEARCHES_PER_CLAIM=2
MAX_SOURCES_PER_CLAIM=4
MAX_MODEL_CONTEXT_CHARS=12000
MIN_AUTHORITATIVE_SOURCES=2

# ─── Cache Controls ───────────────────────────────────────────────────────────
# OPTIONAL — TTL values in seconds.
ENABLE_CACHE=true
CACHE_ARTICLE_TTL=86400
CACHE_YOUTUBE_TTL=86400
CACHE_SEARCH_TTL=3600
CACHE_SOURCE_TTL=43200
